{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-moritalaberap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fec02cd5-49b5-40c0-9ab6-7dc00eb7c3a7","database_name": "web-app-moritlaberap" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d2252559dd084582bd0803643a4fdf5a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
